# Mitsu Configuration
# Copy this file to .env and fill in your values locally.
# Never commit .env to GitHub.

# ── Provider Selection ──────────────────────────────────────────────────────
# Options: gemini | ollama | openrouter
# You can also set this in ~/.mitsu/provider.json
MITSU_PROVIDER="ollama"

# ── Google Gemini (for cloud mode) ─────────────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ── Ollama (for local mode) ────────────────────────────────────────────────
# No config needed — just install Ollama and pull gemma3:1b
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model: ollama pull gemma3:1b
OLLAMA_MODEL="gemma3:1b"
OLLAMA_BASE_URL="http://localhost:11434"

# ── OpenRouter (free tier models) ──────────────────────────────────────────
# Get free key at: https://openrouter.ai/keys
# Default: nvidia/nemotron-3-ultra-550b-a55b:free (550B MoE, 1M context, unlimited)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# ── Voice ──────────────────────────────────────────────────────────────────
# Choose from: puck, charon, kore, fenrir, aoede, leda, orus, schedar, zubenelgenubi
MITSU_VOICE_NAME="puck"

# ── Gmail OAuth (optional) ─────────────────────────────────────────────────
# Gmail uses browser OAuth, never an API key.
#GMAIL_OAUTH_CLIENT_FILE="/absolute/path/to/client_secret_....json"

# ── Presentation (optional) ────────────────────────────────────────────────
#PRESENTATION_QA_MODEL="gemini-2.5-flash"
#GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# ── Runtime Limits (optional) ─────────────────────────────────────────────
#MITSU_TRIAL_KEYWORD="trial"
#MITSU_RUNTIME_SECONDS="3600"

# ── Locked Container (optional) ───────────────────────────────────────────
#MITSU_LOCKED_KEY_SECRET="expected_unlock_key_contents"
#MITSU_LOCKED_VOLUME="NameOfVolumeUnderVolumes"

# ── Local API (optional) ──────────────────────────────────────────────────
#MITSU_API_KEY="YOUR_PRIVATE_API_KEY"

# ── Hosted API (FastAPI + Postgres + Redis) ───────────────────────────────
#DATABASE_URL="postgresql://mitsu:password@localhost:5432/mitsu"
#REDIS_URL="redis://localhost:6379/0"
#JWT_SECRET="generate-a-long-random-value"
#MITSU_ENCRYPTION_KEY="generate-a-separate-long-random-value"
#CORS_ORIGINS="http://localhost:3000"
#MITSU_ENV="development"
#AUTO_CREATE_TABLES="1"
#REDIS_REQUIRED="0"
#ACCESS_TOKEN_MINUTES="1440"
#MITSU_CHAT_MODEL="gemini-2.5-flash"
